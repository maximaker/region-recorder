{
  "manifest_version": 3,
  "name": "Region Recorder",
  "version": "1.5.0",
  "description": "Pick a part of the page, record it, and have the video saved straight to a folder.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "downloads", "downloads.open", "notifications", "storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Record an area (Alt+Shift+R)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start or stop a recording"
    }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
